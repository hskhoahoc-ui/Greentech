<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CÔNG TY TNHH KỸ THUẬT TỰ ĐỘNG HOÁ XANH</title>
    <style>
        * { box-sizing: border-box; }
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; background: #f4f6f9; color: #333; }
        
        /* Header Responsive */
        header { display: flex; align-items: center; justify-content: space-between; padding: 12px 15px; background: #004488; color: white; flex-wrap: wrap; gap: 12px; }
        .company-info { display: flex; align-items: center; gap: 12px; }
        .company-logo { height: 50px; width: 50px; object-fit: contain; background: white; border-radius: 6px; padding: 2px; }
        .company-title { font-size: 1.05rem; margin: 0 0 3px 0; text-transform: uppercase; font-weight: bold; line-height: 1.2; }
        .company-sub { font-size: 0.8rem; margin: 0; opacity: 0.95; line-height: 1.3; }

        /* Navigation Responsive */
        nav.menu { display: flex; align-items: center; gap: 6px; overflow-x: auto; max-width: 100%; padding-bottom: 4px; }
        nav.menu a { color: white; text-decoration: none; font-size: 0.85rem; font-weight: bold; cursor: pointer; padding: 8px 12px; border-radius: 4px; background: rgba(255,255,255,0.15); whitespace: nowrap; }
        nav.menu a:hover, nav.menu a.active-tab { background: #002244; color: #ffcc00; }
        
        /* Layout Mobile Friendly */
        .container { max-width: 1200px; margin: 15px auto; padding: 0 12px; }
        .tab-content { display: none; background: white; padding: 15px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .tab-content.active { display: block; }

        .grid-3 { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 15px; margin-top: 15px; }
        .card { border: 1px solid #ccc; border-radius: 8px; padding: 12px; text-align: center; background: #f9f9f9; }
        .card img { max-width: 100%; height: 160px; object-fit: cover; border-radius: 5px; }
        
        /* Responsive Table */
        .table-responsive { width: 100%; overflow-x: auto; margin-top: 15px; }
        table { width: 100%; border-collapse: collapse; min-width: 600px; }
        table, th, td { border: 1px solid #ddd; padding: 10px; text-align: left; font-size: 0.9rem; }
        th { background: #f2f2f2; }

        .status-active { color: green; font-weight: bold; }
        .status-expired { color: red; font-weight: bold; }
        .alert-popup { background: #ffcccc; color: #cc0000; padding: 12px; border-radius: 5px; margin-bottom: 15px; font-size: 0.9rem; }
        
        /* Form inputs */
        .form-box { background: #f8f9fa; padding: 15px; border-radius: 6px; border: 1px solid #ddd; margin-bottom: 15px; }
        .form-box input, .form-box select { padding: 10px; margin: 5px 0; width: 100%; border: 1px solid #ccc; border-radius: 4px; font-size: 0.95rem; }
        .form-box button { padding: 10px 18px; background: #004488; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.95rem; font-weight: bold; margin-top: 5px; width: 100%; }

        .modal { display: none; position: fixed; z-index: 100; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; padding: 10px; }
        .modal-content { background: white; padding: 20px; border-radius: 8px; width: 100%; max-width: 420px; text-align: center; }
        .modal-content input { width: 100%; padding: 10px; margin: 8px 0; border: 1px solid #ccc; border-radius: 4px; font-size: 0.95rem; }
        .modal-content button { padding: 10px 18px; background: #004488; color: white; border: none; border-radius: 4px; cursor: pointer; margin-top: 5px; width: 100%; font-size: 0.95rem; }

        .btn-edit { background: #ffc107; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .btn-delete { background: #dc3545; color: white; border: none; padding: 6px 12px; border-radius: 4px; cursor: pointer; font-weight: bold; }

        @media (min-width: 768px) {
            .form-box button { width: auto; }
            .modal-content button { width: auto; }
        }

        /* --- CẬP NHẬT PHẦN IN ẤN (MEDIA PRINT) ĐỂ HỖ TRỢ CẢ BÁO GIÁ VÀ XUẤT KHO --- */
        @media print {
            body * { visibility: hidden; }
            /* Cho phép hiển thị tab báo giá hoặc tab xuất kho khi được chọn in */
            #tab-quotes, #tab-quotes *, #tab-warehouse, #tab-warehouse * { visibility: visible; }
            #tab-quotes, #tab-warehouse { position: absolute; left: 0; top: 0; width: 100%; background: white; padding: 0; box-shadow: none; }
            /* Ẩn form nhập liệu, tiêu đề quản lý, nút bấm và các thành phần không cần thiết trên phiếu in */
            .form-box, nav, header, .alert-popup, button, h3 { display: none !important; }
        }
    </style>
</head>
<body>

    <header>
        <div class="company-info">
            <img src="/images/logo.png" onerror="this.src='https://via.placeholder.com/50?text=LOGO'" alt="Logo" class="company-logo">
            <div>
                <h2 class="company-title">CÔNG TY TNHH KỸ THUẬT TỰ ĐỘNG HOÁ XANH</h2>
                <p class="company-sub">
                    📍 Địa chỉ: 263/16, ấp Hoà Đông, xã Phú Hoà, An Giang<br>☎️ SĐT: 0350.274.913
                </p>
            </div>
        </div>
        
        <nav class="menu">
            <a id="m-products" onclick="switchTab('products')" class="active-tab">Sản Phẩm</a>
            <a id="m-services" onclick="switchTab('services')">Dịch Vụ</a>
            <a id="m-projects" onclick="switchTab('projects')">Dự Án</a>
            <a id="m-quotes" onclick="switchTab('quotes')" style="color:#ffcc00;">Báo Giá</a>
            <a id="m-warehouse" onclick="switchTab('warehouse')" style="color:#ffcc00;">Xuất Kho</a>
            <a id="m-inventory" onclick="switchTab('inventory')" style="color:#ffcc00;">Tồn Kho</a>
            <a id="m-revenue" onclick="switchTab('revenue')" style="color:#ffcc00;">Doanh Thu</a>
            <a id="m-expenses" onclick="switchTab('expenses')" style="color:#ffcc00;">Chi Phí</a>
            <a onclick="openAdminPanel()" style="color: #00ffcc;">Quản Trị</a>
            <a onclick="logout()" style="color: #ff9999;">Đăng Xuất</a>
        </nav>
    </header>

    <div class="container">
        
        <!-- TAB 1: SẢN PHẨM -->
        <div id="tab-products" class="tab-content active">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
                <h3 style="margin:0;">Danh Mục Sản Phẩm</h3>
                <button onclick="openCategoryModal()" style="background: #28a745; color: white; border: none; padding: 8px 15px; border-radius: 4px; cursor: pointer; font-weight: bold;">+ Thêm Danh Mục Mới</button>
            </div>
            <div class="grid-3">
                <div class="card">
                    <div onclick="window.location.href='/category/7'" style="cursor: pointer;">
                        <img src="https://i.postimg.cc/2jwQnjQ3/IMG-20261022-102404.jpg" alt="Tủ điện">
                        <h4>Tủ điện</h4>
                    </div>
                    <div style="margin-top: 10px; display: flex; gap: 5px; justify-content: center;">
                        <button class="btn-edit" onclick="editCategory('7', 'Tủ điện', 'https://i.postimg.cc/2jwQnjQ3/IMG-20261022-102404.jpg')">Sửa</button>
                        <button class="btn-delete" onclick="deleteCategory('7')">Xóa</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: DỊCH VỤ -->
        <div id="tab-services" class="tab-content">
            <h3>Quản Lý Dịch Vụ Nổi Bật</h3>
            <div class="form-box">
                <h4>➕ Thêm Dịch Vụ</h4>
                <input type="text" id="sType" placeholder="Loại dịch vụ">
                <input type="text" id="sContent" placeholder="Nội dung">
                <input type="text" id="sWarranty" placeholder="Bảo hành / Bảo dưỡng">
                <input type="number" id="sPrice" placeholder="Giá (VNĐ)">
                <button onclick="addService()">Lưu Dịch Vụ</button>
            </div>
        </div>

        <!-- TAB 3: DỰ ÁN -->
        <div id="tab-projects" class="tab-content">
            <h3>Quản Lý Khách Hàng Dự Án & Bảo Hành</h3>
        </div>

        <!-- TAB 4: BÁO GIÁ -->
        <div id="tab-quotes" class="tab-content">
            <h3>Lập & In Báo Giá (Khổ A4)</h3>
            <div class="form-box">
                <h4>➕ Tạo Báo Giá Mới</h4>
                <input type="text" id="qCode" placeholder="Mã Báo Giá (VD: BG-01)">
                <input type="text" id="qCust" placeholder="Tên Khách Hàng">
                <input type="text" id="qProj" placeholder="Tên Dự Án">
                <input type="text" id="qAddress" placeholder="Địa chỉ công trình">
                <button type="button" onclick="addItemToQuote()" style="background: #17a2b8; color: white;">Thêm vào báo giá</button>
                <button onclick="saveAndPrintQuote()" style="background: #28a745; color: white;">💾 Lưu & In Báo Giá (A4)</button>
            </div>
        </div>

        <!-- TAB 5: XUẤT KHO -->
        <div id="tab-warehouse" class="tab-content">
            <h3>Quản Lý Phiếu Xuất Kho</h3>
            <div class="form-box">
                <h4>➕ Lập Phiếu Xuất Kho</h4>
                <label><strong>Chọn từ Mã Báo Giá:</strong></label>
                <select id="selectQuoteCode" onchange="fillDataFromQuote()">
                    <option value="">-- Chọn mã báo giá --</option>
                    <option value="BG10.06XNCNLX" data-cust="XNCN Long Xuyên" data-proj="Cầp vật tư tụ bù NMN Bình Đức" data-addr="phường Bình Đưc ">Mã: BG10.06XNCNLX - Khách: XNCN Long Xuyên</option>
                </select>
                <input type="text" id="wCust" placeholder="Tên Khách Hàng">
                <input type="text" id="wProj" placeholder="Tên Dự Án">
                <input type="text" id="wAddress" placeholder="Địa chỉ giao hàng">
                <input type="text" id="wPhone" placeholder="Số điện thoại">
                <button onclick="createWarehouseTicket()" style="background: #004488;">📦 Xuất Kho & In Phiếu</button>
            </div>
            
            <!-- Khu vực hiển thị bảng danh sách phiếu xuất kho để khi in có dữ liệu trực quan -->
            <div class="table-responsive">
                <table id="warehouseTablePrint">
                    <thead>
                        <tr><th>Mã Phiếu Xuất</th><th>Khách Hàng</th><th>Dự Án</th><th>Địa Chỉ</th><th>Ngày Xuất</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>PXK-1793881808933</td><td>XNCN Long Xuyên</td><td>Cầp vật tư tụ bù NMN Bình Đức</td><td>phường Bình Đưc</td><td>5/11/2026</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TAB 6: TỒN KHO -->
        <div id="tab-inventory" class="tab-content">
            <h3>Kiểm Tra Tồn Kho Sản Phẩm / Vật Tư</h3>
        </div>

        <!-- TAB 7: DOANH THU -->
        <div id="tab-revenue" class="tab-content">
            <h3>Quản Lý Doanh Thu & Báo Cáo</h3>
        </div>

        <!-- TAB 8: CHI PHÍ -->
        <div id="tab-expenses" class="tab-content">
            <h3>Quản Lý Chi Phí Doanh Nghiệp</h3>
        </div>

    </div>

    <script>
        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.menu a').forEach(el => el.classList.remove('active-tab'));
            const targetTab = document.getElementById('tab-' + tabName);
            const targetMenu = document.getElementById('m-' + tabName);
            if (targetTab) targetTab.classList.add('active');
            if (targetMenu) targetMenu.classList.add('active-tab');
        }

        function fillDataFromQuote() {
            const select = document.getElementById('selectQuoteCode');
            const opt = select.options[select.selectedIndex];
            if (opt.value) {
                document.getElementById('wCust').value = opt.getAttribute('data-cust');
                document.getElementById('wProj').value = opt.getAttribute('data-proj');
                document.getElementById('wAddress').value = opt.getAttribute('data-addr');
            }
        }

        async function createWarehouseTicket() {
            const customer_name = document.getElementById('wCust').value;
            const project_name = document.getElementById('wProj').value;
            const address = document.getElementById('wAddress').value;
            const phone = document.getElementById('wPhone').value;

            if (!customer_name) {
                alert('Vui lòng chọn hoặc nhập thông tin khách hàng!');
                return;
            }

            const res = await fetch('/api/export-warehouse', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ customer_name, project_name, address, phone })
            });
            const data = await res.json();
            if (data.success) {
                alert('Xuất kho thành công, đã giảm trừ tồn kho! Mã phiếu: ' + data.ticket_code);
                // Gọi lệnh in ngay sau khi xuất kho thành công
                window.print();
                window.location.reload();
            } else {
                alert('Lỗi: ' + (data.message || 'Không thể xuất kho'));
            }
        }
    </script>
</body>
</html>
