<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Công ty Thiết Bị Điện & Năng Lượng</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; background: #f4f6f9; }
        header { display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; background: #004488; color: white; flex-wrap: wrap; }
        header h2 { font-size: 1.2rem; margin: 0; }
        nav.menu { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
        nav.menu a { color: white; text-decoration: none; font-size: 0.9rem; font-weight: bold; cursor: pointer; padding: 6px 10px; border-radius: 4px; background: rgba(255,255,255,0.1); }
        nav.menu a:hover, nav.menu a.active-tab { background: #002244; color: #ffcc00; }
        
        .container { max-width: 1200px; margin: 25px auto; padding: 0 20px; }
        .tab-content { display: none; background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .tab-content.active { display: block; }

        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; }
        .card { border: 1px solid #ccc; border-radius: 8px; padding: 15px; text-align: center; background: #f9f9f9; cursor: pointer; }
        .card img { max-width: 100%; height: 160px; object-fit: cover; border-radius: 5px; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        table, th, td { border: 1px solid #ddd; padding: 10px; text-align: left; font-size: 0.95rem; }
        th { background: #f2f2f2; }

        .status-active { color: green; font-weight: bold; }
        .status-expired { color: red; font-weight: bold; }
        .alert-popup { background: #ffcccc; color: #cc0000; padding: 10px; border-radius: 5px; margin-bottom: 15px; }
        
        .admin-bar { margin-bottom: 20px; padding: 12px; background: #e9ecef; border-radius: 6px; display: flex; gap: 15px; align-items: center; }
        .btn-admin { padding: 8px 15px; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; font-weight: bold; }

        .form-box { background: #f8f9fa; padding: 15px; border-radius: 6px; border: 1px solid #ddd; margin-bottom: 20px; }
        .form-box input, .form-box select { padding: 8px; margin: 5px 5px 5px 0; width: 220px; border: 1px solid #ccc; border-radius: 4px; }
        .form-box button { padding: 8px 15px; background: #004488; color: white; border: none; border-radius: 4px; cursor: pointer; }

        .modal { display: none; position: fixed; z-index: 10; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; }
        .modal-content { background: white; padding: 30px; border-radius: 8px; width: 420px; text-align: center; }
        .modal-content input { width: 90%; padding: 10px; margin: 8px 0; border: 1px solid #ccc; border-radius: 4px; }
        .modal-content button { padding: 10px 20px; background: #004488; color: white; border: none; border-radius: 4px; cursor: pointer; margin-top: 5px; }
    </style>
</head>
<body>

    <header>
        <h2>THIẾT BỊ ĐIỆN & NLMT</h2>
        <nav class="menu">
            <a id="m-products" onclick="switchTab('products')" class="active-tab">Sản Phẩm</a>
            <a id="m-services" onclick="switchTab('services')">Dịch Vụ</a>
            <a id="m-projects" onclick="switchTab('projects')">Dự Án</a>
            
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <a id="m-quotes" onclick="switchTab('quotes')" style="color:#ffcc00;">Báo Giá & Kho</a>
                <a id="m-expenses" onclick="switchTab('expenses')" style="color:#ffcc00;">Chi Phí & Doanh Thu</a>
                <a onclick="openAdminPanel()" style="color: #00ffcc;">Quản Trị</a>
                <a onclick="logout()" style="color: #ff9999;">Đăng Xuất</a>
            <% } else { %>
                <a onclick="openLoginModal()" style="color: #ffcc00;">Đăng Nhập Admin</a>
            <% } %>
        </nav>
    </header>

    <div class="container">
        
        <!-- Cảnh báo bảo hành -->
        <% const safeProjects = projects || []; %>
        <% const expiredProjects = safeProjects.filter(p => p.isExpired); %>
        <% if (expiredProjects.length > 0) { %>
            <div class="alert-popup">
                <strong>🔔 THÔNG BÁO BẢO HÀNH:</strong> Có <%= expiredProjects.length %> dự án đã hết hạn bảo hành/bảo dưỡng!
            </div>
        <% } %>

        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <div class="admin-bar">
                <strong>QUẢN TRỊ ADMIN:</strong>
                <a href="/api/export-revenue-excel" class="btn-admin" style="background: #17a2b8;">📥 Xuất Báo Cáo Excel Doanh Thu & Chi Phí</a>
            </div>
        <% } %>

        <!-- TAB 1: SẢN PHẨM -->
        <div id="tab-products" class="tab-content active">
            <h3>Danh Mục Sản Phẩm</h3>
            <div class="grid-3">
                <% (categories || []).forEach(cat => { %>
                    <div class="card" onclick="window.location.href='/category/<%= cat.id %>'">
                        <img src="<%= cat.avatar_url || 'https://via.placeholder.com/150' %>" alt="<%= cat.name %>">
                        <h4><%= cat.name %></h4>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- TAB 2: DỊCH VỤ -->
        <div id="tab-services" class="tab-content">
            <h3>Quản Lý Dịch Vụ Nổi Bật</h3>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <div class="form-box">
                    <h4>➕ Thêm Dịch Vụ Mới</h4>
                    <input type="text" id="sType" placeholder="Loại Dịch Vụ">
                    <input type="text" id="sContent" placeholder="Nội Dung">
                    <input type="text" id="sWarranty" placeholder="Bảo Hành / Bảo Dưỡng">
                    <input type="number" id="sPrice" placeholder="Giá (VNĐ)">
                    <button onclick="addService()">Lưu Dịch Vụ</button>
                </div>
            <% } %>
            <table>
                <thead>
                    <tr>
                        <th>Loại Dịch Vụ</th>
                        <th>Nội Dung</th>
                        <th>Bảo Hành / Bảo Dưỡng</th>
                        <th>Giá</th>
                    </tr>
                </thead>
                <tbody>
                    <% (services || []).forEach(s => { %>
                        <tr>
                            <td><%= s.service_type %></td>
                            <td><%= s.content %></td>
                            <td><%= s.warranty_maintenance %></td>
                            <td><%= Number(s.price || 0).toLocaleString('vi-VN') %> VNĐ</td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- TAB 3: KHÁCH HÀNG DỰ ÁN -->
        <div id="tab-projects" class="tab-content">
            <h3>Quản Lý Khách Hàng Dự Án & Bảo Hành</h3>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <div class="form-box">
                    <h4>➕ Thêm Dự Án Khách Hàng Mới</h4>
                    <input type="text" id="pCustName" placeholder="Tên Khách Hàng">
                    <input type="text" id="pProjName" placeholder="Tên Dự Án">
                    <input type="date" id="pCompDate" placeholder="Ngày Hoàn Công">
                    <input type="number" id="pWarrantyMos" placeholder="Số tháng bảo hành">
                    <button onclick="addProject()">Lưu Dự Án</button>
                </div>
            <% } %>
            <table>
                <thead>
                    <tr>
                        <th>Tên Khách Hàng</th>
                        <th>Tên Dự Án</th>
                        <th>Thời Gian Hoàn Công</th>
                        <th>Hạn Bảo Hành</th>
                        <th>Trạng Thái</th>
                    </tr>
                </thead>
                <tbody>
                    <% safeProjects.forEach(p => { %>
                        <tr>
                            <td><%= p.customer_name %></td>
                            <td><%= p.project_name %></td>
                            <td><%= p.completion_date %></td>
                            <td class="<%= p.isExpired ? 'status-expired' : 'status-active' %>"><%= p.expiryDate %></td>
                            <td>
                                <% if (p.isExpired) { %>
                                    <span class="status-expired">Đã Hết Bảo Hành</span>
                                <% } else { %>
                                    <span class="status-active">Còn Bảo Hành</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- TAB 4: BÁO GIÁ & XUẤT KHO (Dành cho Admin) -->
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <div id="tab-quotes" class="tab-content">
                <h3>Tạo Báo Giá & Xuất Kho</h3>
                <div class="form-box">
                    <h4>➕ Lập Phiếu Báo Giá Mới</h4>
                    <input type="text" id="qCode" placeholder="Mã Báo Giá (VD: Q-001)">
                    <input type="text" id="qCust" placeholder="Tên Khách Hàng">
                    <input type="text" id="qProj" placeholder="Tên Dự Án">
                    <input type="text" id="qAddress" placeholder="Địa chỉ công trình">
                    <input type="number" id="qAmount" placeholder="Tổng tiền (VNĐ)">
                    <button onclick="addQuote()">Tạo Báo Giá</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Mã Báo Giá</th>
                            <th>Khách Hàng</th>
                            <th>Dự Án</th>
                            <th>Tổng Tiền</th>
                            <th>Ngày Tạo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% (quotes || []).forEach(q => { %>
                            <tr>
                                <td><%= q.quote_code %></td>
                                <td><%= q.customer_name %></td>
                                <td><%= q.project_name %></td>
                                <td><%= Number(q.total_amount || 0).toLocaleString('vi-VN') %> VNĐ</td>
                                <td><%= new Date(q.created_at).toLocaleDateString('vi-VN') %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- TAB 5: CHI PHÍ & DOANH THU (Dành cho Admin) -->
            <div id="tab-expenses" class="tab-content">
                <h3>Quản Lý Chi Phí & Doanh Thu</h3>
                <div class="form-box">
                    <h4>➕ Thêm Khoản Chi Phí Mới</h4>
                    <input type="text" id="expType" placeholder="Loại chi phí (VD: Vật tư)">
                    <input type="text" id="expDesc" placeholder="Mô tả chi tiết">
                    <input type="number" id="expAmount" placeholder="Số tiền (VNĐ)">
                    <input type="date" id="expDate">
                    <button onclick="addExpense()">Lưu Chi Phí</button>
                </div>
                <table>
                    <thead>
                        <tr>
                            <th>Loại Chi Phí</th>
                            <th>Mô Tả</th>
                            <th>Số Tiền</th>
                            <th>Ngày Nhập</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% (expenses || []).forEach(e => { %>
                            <tr>
                                <td><%= e.expense_type %></td>
                                <td><%= e.description %></td>
                                <td><%= Number(e.amount || 0).toLocaleString('vi-VN') %> VNĐ</td>
                                <td><%= e.expense_date %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>

    </div>

    <!-- Modal Đăng nhập -->
    <div id="loginModal" class="modal">
        <div class="modal-content">
            <h3>Đăng Nhập Quản Trị</h3>
            <input type="text" id="username" placeholder="Tài khoản"><br>
            <input type="password" id="password" placeholder="Mật khẩu"><br>
            <button onclick="submitLogin()">Đăng Nhập</button>
            <button onclick="closeLoginModal()" style="background: #aaa; margin-left: 10px;">Đóng</button>
        </div>
    </div>

    <!-- Modal Admin -->
    <div id="adminPanelModal" class="modal">
        <div class="modal-content">
            <h3>Quản Trị Tài Khoản Admin</h3>
            <hr>
            <h4>Đổi Mật Khẩu</h4>
            <input type="password" id="oldPassword" placeholder="Mật khẩu cũ"><br>
            <input type="password" id="newPassword" placeholder="Mật khẩu mới"><br>
            <button onclick="changePassword()">Cập Nhật</button>
            <hr>
            <h4>Tạo Admin Mới</h4>
            <input type="text" id="newAdminUser" placeholder="Tài khoản mới"><br>
            <input type="password" id="newAdminPass" placeholder="Mật khẩu mới"><br>
            <button onclick="createAdmin()" style="background: #28a745;">Tạo Tài Khoản</button>
            <br><br>
            <button onclick="closeAdminPanel()" style="background: #6c757d;">Đóng</button>
        </div>
    </div>

    <script>
        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.menu a').forEach(el => el.classList.remove('active-tab'));
            
            const targetTab = document.getElementById('tab-' + tabName);
            const targetMenu = document.getElementById('m-' + tabName);
            
            if (targetTab) targetTab.classList.add('active');
            if (targetMenu) targetMenu.classList.add('active-tab');
        }

        function openLoginModal() { document.getElementById('loginModal').style.display = 'flex'; }
        function closeLoginModal() { document.getElementById('loginModal').style.display = 'none'; }

        async function submitLogin() {
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value.trim();
            const res = await fetch('/api/login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });
            const data = await res.json();
            if (data.success) {
                alert('Đăng nhập thành công!');
                window.location.reload();
            } else {
                alert(data.message);
            }
        }

        async function logout() {
            await fetch('/api/logout', { method: 'POST' });
            window.location.reload();
        }

        function openAdminPanel() { document.getElementById('adminPanelModal').style.display = 'flex'; }
        function closeAdminPanel() { document.getElementById('adminPanelModal').style.display = 'none'; }

        async function changePassword() {
            const oldPassword = document.getElementById('oldPassword').value;
            const newPassword = document.getElementById('newPassword').value;
            const res = await fetch('/api/change-password', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ oldPassword, newPassword })
            });
            const data = await res.json();
            alert(data.message);
            if (data.success) window.location.reload();
        }

        async function createAdmin() {
            const username = document.getElementById('newAdminUser').value;
            const password = document.getElementById('newAdminPass').value;
            const res = await fetch('/api/users/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ username, password })
            });
            const data = await res.json();
            if (data.success) {
                alert('Tạo tài khoản quản trị thành công!');
                window.location.reload();
            } else {
                alert('Lỗi: ' + data.message);
            }
        }

        async function addService() {
            const service_type = document.getElementById('sType').value;
            const content = document.getElementById('sContent').value;
            const warranty_maintenance = document.getElementById('sWarranty').value;
            const price = document.getElementById('sPrice').value;

            const res = await fetch('/api/services/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ service_type, content, warranty_maintenance, price })
            });
            const data = await res.json();
            if (data.success) { alert('Thêm dịch vụ thành công!'); window.location.reload(); }
            else { alert('Lỗi: ' + data.message); }
        }

        async function addProject() {
            const customer_name = document.getElementById('pCustName').value;
            const project_name = document.getElementById('pProjName').value;
            const completion_date = document.getElementById('pCompDate').value;
            const warranty_months = document.getElementById('pWarrantyMos').value;

            const res = await fetch('/api/projects/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ customer_name, project_name, completion_date, warranty_months })
            });
            const data = await res.json();
            if (data.success) { alert('Thêm dự án thành công!'); window.location.reload(); }
            else { alert('Lỗi: ' + data.message); }
        }

        async function addQuote() {
            const quote_code = document.getElementById('qCode').value;
            const customer_name = document.getElementById('qCust').value;
            const project_name = document.getElementById('qProj').value;
            const address = document.getElementById('qAddress').value;
            const total_amount = document.getElementById('qAmount').value;

            const res = await fetch('/api/quotes/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ quote_code, customer_name, project_name, address, total_amount })
            });
            const data = await res.json();
            if (data.success) { alert('Tạo báo giá thành công!'); window.location.reload(); }
            else { alert('Lỗi: ' + data.message); }
        }

        async function addExpense() {
            const expense_type = document.getElementById('expType').value;
            const description = document.getElementById('expDesc').value;
            const amount = document.getElementById('expAmount').value;
            const expense_date = document.getElementById('expDate').value;

            const res = await fetch('/api/expenses/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ expense_type, description, amount, expense_date })
            });
            const data = await res.json();
            if (data.success) {
                alert('Thêm chi phí thành công!');
                window.location.reload();
            } else {
                alert('Lỗi: ' + (data.message || 'Không thể thêm chi phí'));
            }
        }
    </script>
</body>
</html>
