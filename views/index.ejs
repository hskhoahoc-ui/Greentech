<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Công ty Thiết Bị Điện & Năng Lượng</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; }
        header { display: flex; align-items: center; justify-content: space-between; padding: 15px 30px; background: #004488; color: white; }
        header img.logo { height: 50px; }
        nav.menu a { color: white; text-decoration: none; margin: 0 15px; font-weight: bold; }
        .container { padding: 20px; }
        
        /* Grid 3 ô/dòng cho Danh mục & Sản phẩm */
        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; }
        .card { border: 1px solid #ccc; border-radius: 8px; padding: 15px; text-align: center; background: #f9f9f9; cursor: pointer; }
        .card img { max-width: 100%; height: 180px; object-fit: cover; border-radius: 5px; }

        /* Bảng */
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        table, th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        th { background: #f2f2f2; }

        /* Mầu bảo hành */
        .status-active { color: green; font-weight: bold; }
        .status-expired { color: red; font-weight: bold; }
        .alert-popup { background: #ffcccc; color: #cc0000; padding: 10px; border-radius: 5px; margin-bottom: 15px; }
    </style>
</head>
<body>

    <!-- Header: Logo & Tên Công ty -->
    <header>
        <div style="display:flex; align-items:center; gap: 15px;">
            <img src="https://postimg.cc/logo-sample.png" alt="Logo" class="logo">
            <h2>CÔNG TY TNHH THIẾT BỊ ĐIỆN & NLMT</h2>
        </div>
        <nav class="menu">
            <a href="#products">Sản phẩm</a>
            <a href="#services">Dịch vụ</a>
            <a href="#projects">Khách hàng dự án</a>
            <a href="#support">Hỗ trợ khách hàng</a>
        </nav>
    </header>

    <div class="container">
        
        <!-- Cảnh báo Bảo hành hết hạn -->
        <% const expiredProjects = projects.filter(p => p.isExpired); %>
        <% if (expiredProjects.length > 0) { %>
            <div class="alert-popup">
                <strong>🔔 THÔNG BÁO BẢO HÀNH:</strong> Có <%= expiredProjects.length %> dự án đã hết hạn bảo hành/bảo dưỡng!
            </div>
        <% } %>

        <!-- SECTION 1: DANH MỤC SẢN PHẨM -->
        <h3 id="products">Danh Mục Sản Phẩm</h3>
        <div class="grid-3">
<% (categories || []).forEach(cat => { %>
<div class="card" onclick="window.location.href='/category/<%= cat.id %>'">
                    <img src="<%= cat.avatar_url %>" alt="<%= cat.name %>">
                    <h4><%= cat.name %></h4>
                </div>
            <% }) %>
        </div>

        <!-- SECTION 2: DỊCH VỤ -->
        <h3 id="services" style="margin-top:40px;">Dịch Vụ Nổi Bật</h3>
        <table>
            <thead>
                <tr>
                    <th>Loại Dịch Vụ</th>
                    <th>Nội Dung</th>
                    <th>Bảo Hành / Bảo Dưỡng</th>
                    <th>Giá</th>
                </tr>
            </thead>
            <tbody>
                <% services.forEach(s => { %>
                    <tr>
                        <td><%= s.service_type %></td>
                        <td><%= s.content %></td>
                        <td><%= s.warranty_maintenance %></td>
                        <td><%= Number(s.price).toLocaleString('vi-VN') %> VNĐ</td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

        <!-- SECTION 3: KHÁCH HÀNG DỰ ÁN -->
        <h3 id="projects" style="margin-top:40px;">Danh Sách Khách Hàng Dự Án</h3>
        <table>
            <thead>
                <tr>
                    <th>Tên Khách Hàng</th>
                    <th>Tên Dự Án</th>
                    <th>Thời Gian Hoàn Công</th>
                    <th>Hạn Bảo Hành</th>
                    <th>Trạng Thái</th>
                </tr>
            </thead>
            <tbody>
                <% projects.forEach(p => { %>
                    <tr>
                        <td><%= p.customer_name %></td>
                        <td><%= p.project_name %></td>
                        <td><%= p.completion_date %></td>
                        <td class="<%= p.isExpired ? 'status-expired' : 'status-active' %>">
                            <%= p.expiryDate %>
                        </td>
                        <td>
                            <% if (p.isExpired) { %>
                                <span class="status-expired">Đã Hết Bảo Hành</span>
                            <% } else { %>
                                <span class="status-active">Còn Bảo Hành</span>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>

    </div>

</body>
</html>
