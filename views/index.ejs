<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Công ty Thiết Bị Điện & Năng Lượng</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 0; background: #f4f6f9; }
        header { display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; background: #004488; color: white; flex-wrap: wrap; }
        header h2 { font-size: 1.2rem; margin: 0; }
        nav.menu { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
        nav.menu a { color: white; text-decoration: none; font-size: 0.85rem; font-weight: bold; cursor: pointer; padding: 6px 8px; border-radius: 4px; background: rgba(255,255,255,0.1); }
        nav.menu a:hover, nav.menu a.active-tab { background: #002244; color: #ffcc00; }
        
        .container { max-width: 1200px; margin: 25px auto; padding: 0 20px; }
        .tab-content { display: none; background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }
        .tab-content.active { display: block; }

        .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px; }
        .card { border: 1px solid #ccc; border-radius: 8px; padding: 15px; text-align: center; background: #f9f9f9; cursor: pointer; }
        .card img { max-width: 100%; height: 160px; object-fit: cover; border-radius: 5px; }
        
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        table, th, td { border: 1px solid #ddd; padding: 10px; text-align: left; font-size: 0.95rem; }
        th { background: #f2f2f2; }

        .status-active { color: green; font-weight: bold; }
        .status-expired { color: red; font-weight: bold; }
        .alert-popup { background: #ffcccc; color: #cc0000; padding: 10px; border-radius: 5px; margin-bottom: 15px; }
        
        .form-box { background: #f8f9fa; padding: 15px; border-radius: 6px; border: 1px solid #ddd; margin-bottom: 20px; }
        .form-box input { padding: 8px; margin: 5px 5px 5px 0; width: 200px; border: 1px solid #ccc; border-radius: 4px; }
        .form-box button { padding: 8px 15px; background: #004488; color: white; border: none; border-radius: 4px; cursor: pointer; }

        .modal { display: none; position: fixed; z-index: 10; left: 0; top: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); justify-content: center; align-items: center; }
        .modal-content { background: white; padding: 30px; border-radius: 8px; width: 400px; text-align: center; }
        .modal-content input { width: 90%; padding: 10px; margin: 8px 0; border: 1px solid #ccc; border-radius: 4px; }
        .modal-content button { padding: 10px 20px; background: #004488; color: white; border: none; border-radius: 4px; cursor: pointer; margin-top: 5px; }
    </style>
</head>
<body>

    <header>
        <h2>THIẾT BỊ ĐIỆN & NLMT</h2>
        <nav class="menu">
            <a id="m-products" onclick="switchTab('products')" class="active-tab">Sản Phẩm</a>
            <a id="m-services" onclick="switchTab('services')">Dịch Vụ</a>
            <a id="m-projects" onclick="switchTab('projects')">Dự Án</a>
            
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <a id="m-quotes" onclick="switchTab('quotes')" style="color:#ffcc00;">Báo Giá</a>
                <a id="m-warehouse" onclick="switchTab('warehouse')" style="color:#ffcc00;">Xuất Kho</a>
                <a id="m-inventory" onclick="switchTab('inventory')" style="color:#ffcc00;">Tồn Kho</a>
                <a id="m-revenue" onclick="switchTab('revenue')" style="color:#ffcc00;">Doanh Thu</a>
                <a id="m-expenses" onclick="switchTab('expenses')" style="color:#ffcc00;">Chi Phí</a>
                <a onclick="openAdminPanel()" style="color: #00ffcc;">Quản Trị</a>
                <a onclick="logout()" style="color: #ff9999;">Đăng Xuất</a>
            <% } else { %>
                <a onclick="openLoginModal()" style="color: #ffcc00;">Đăng Nhập</a>
            <% } %>
        </nav>
    </header>

    <div class="container">
        
        <% const safeProjects = projects || []; %>
        <% const expiredProjects = safeProjects.filter(p => p.isExpired); %>
        <% if (expiredProjects.length > 0) { %>
            <div class="alert-popup">
                <strong>🔔 THÔNG BÁO BẢO HÀNH:</strong> Có <%= expiredProjects.length %> dự án đã hết hạn bảo hành!
            </div>
        <% } %>

        <!-- TAB 1: SẢN PHẨM -->
        <div id="tab-products" class="tab-content active">
            <h3>Danh Mục Sản Phẩm</h3>
            <div class="grid-3">
                <% (categories || []).forEach(cat => { %>
                    <div class="card" onclick="window.location.href='/category/<%= cat.id %>'">
                        <img src="<%= cat.avatar_url || 'https://via.placeholder.com/150' %>" alt="<%= cat.name %>">
                        <h4><%= cat.name %></h4>
                    </div>
                <% }) %>
            </div>
        </div>

        <!-- TAB 2: DỊCH VỤ -->
        <div id="tab-services" class="tab-content">
            <h3>Quản Lý Dịch Vụ Nổi Bật</h3>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <div class="form-box">
                    <h4>➕ Thêm Dịch Vụ</h4>
                    <input type="text" id="sType" placeholder="Loại dịch vụ">
                    <input type="text" id="sContent" placeholder="Nội dung">
                    <input type="text" id="sWarranty" placeholder="Bảo hành / Bảo dưỡng">
                    <input type="number" id="sPrice" placeholder="Giá (VNĐ)">
                    <button onclick="addService()">Lưu Dịch Vụ</button>
                </div>
            <% } %>
            <table>
                <thead>
                    <tr><th>Loại Dịch Vụ</th><th>Nội Dung</th><th>Bảo Hành</th><th>Giá</th></tr>
                </thead>
                <tbody>
                    <% (services || []).forEach(s => { %>
                        <tr><td><%= s.service_type %></td><td><%= s.content %></td><td><%= s.warranty_maintenance %></td><td><%= Number(s.price || 0).toLocaleString('vi-VN') %> VNĐ</td></tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- TAB 3: DỰ ÁN -->
        <div id="tab-projects" class="tab-content">
            <h3>Quản Lý Khách Hàng Dự Án & Bảo Hành</h3>
            <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
                <div class="form-box">
                    <h4>➕ Thêm Dự Án Mới</h4>
                    <input type="text" id="pCustName" placeholder="Tên Khách Hàng">
                    <input type="text" id="pProjName" placeholder="Tên Dự Án">
                    <input type="date" id="pCompDate">
                    <input type="number" id="pWarrantyMos" placeholder="Số tháng BH">
                    <button onclick="addProject()">Lưu Dự Án</button>
                </div>
            <% } %>
            <table>
                <thead>
                    <tr><th>Tên Khách Hàng</th><th>Tên Dự Án</th><th>Ngày Hoàn Công</th><th>Hạn Bảo Hành</th><th>Trạng Thái</th></tr>
                </thead>
                <tbody>
                    <% safeProjects.forEach(p => { %>
                        <tr>
                            <td><%= p.customer_name %></td>
                            <td><%= p.project_name %></td>
                            <td><%= p.completion_date %></td>
                            <td class="<%= p.isExpired ? 'status-expired' : 'status-active' %>"><%= p.expiryDate %></td>
                            <td><%= p.isExpired ? 'Đã Hết Bảo Hành' : 'Còn Bảo Hành' %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
            <!-- TAB 4: BÁO GIÁ -->
            <div id="tab-quotes" class="tab-content">
                <h3>Quản Lý Báo Giá</h3>
                <div class="form-box">
                    <h4>➕ Lập Báo Giá Mới</h4>
                    <input type="text" id="qCode" placeholder="Mã Báo Giá">
                    <input type="text" id="qCust" placeholder="Tên Khách Hàng">
                    <input type="text" id="qProj" placeholder="Tên Dự Án">
                    <input type="text" id="qAddress" placeholder="Địa chỉ">
                    <input type="number" id="qAmount" placeholder="Tổng tiền (VNĐ)">
                    <button onclick="addQuote()">Tạo Báo Giá</button>
                </div>
                <table>
                    <thead>
                        <tr><th>Mã Báo Giá</th><th>Khách Hàng</th><th>Dự Án</th><th>Tổng Tiền</th><th>Ngày Tạo</th></tr>
                    </thead>
                    <tbody>
                        <% (quotes || []).forEach(q => { %>
                            <tr><td><%= q.quote_code %></td><td><%= q.customer_name %></td><td><%= q.project_name %></td><td><%= Number(q.total_amount || 0).toLocaleString('vi-VN') %> VNĐ</td><td><%= new Date(q.created_at).toLocaleDateString('vi-VN') %></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- TAB 5: XUẤT KHO -->
            <div id="tab-warehouse" class="tab-content">
                <h3>Quản Lý Phiếu Xuất Kho</h3>
                <div class="form-box">
                    <h4>➕ Lập Phiếu Xuất Kho Mới</h4>
                    <input type="text" id="wCust" placeholder="Tên Khách Hàng">
                    <input type="text" id="wProj" placeholder="Tên Dự Án">
                    <input type="text" id="wAddress" placeholder="Địa chỉ giao">
                    <input type="text" id="wPhone" placeholder="Số điện thoại">
                    <button onclick="addWarehouseTicket()">Tạo Phiếu Xuất</button>
                </div>
                <table>
                    <thead>
                        <tr><th>Mã Phiếu Xuất</th><th>Khách Hàng</th><th>Dự Án</th><th>Địa Chỉ</th><th>Ngày Xuất</th></tr>
                    </thead>
                    <tbody>
                        <% (exportTickets || []).forEach(t => { %>
                            <tr><td><%= t.ticket_code %></td><td><%= t.customer_name %></td><td><%= t.project_name %></td><td><%= t.address %></td><td><%= new Date(t.created_at).toLocaleDateString('vi-VN') %></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- TAB 6: TỒN KHO -->
            <div id="tab-inventory" class="tab-content">
                <h3>Quản Lý & Kiểm Tra Tồn Kho Vật Tư/Sản Phẩm</h3>
                <table>
                    <thead>
                        <tr><th>Tên Sản Phẩm</th><th>Mô Tả</th><th>Số Lượng Tồn Kho</th><th>Giá Bán</th></tr>
                    </thead>
                    <tbody>
                        <% (products || []).forEach(prod => { %>
                            <tr>
                                <td><%= prod.name %></td>
                                <td><%= prod.description %></td>
                                <td><strong style="color: <%= prod.quantity > 5 ? 'green' : 'red' %>;"><%= prod.quantity || 0 %></strong></td>
                                <td><%= Number(prod.selling_price || 0).toLocaleString('vi-VN') %> VNĐ</td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- TAB 7: DOANH THU -->
            <div id="tab-revenue" class="tab-content">
                <h3>Quản Lý Doanh Thu Dự Án</h3>
                <div style="margin-bottom: 20px;">
                    <a href="/api/export-revenue-excel" class="form-box" style="background:#17a2b8; color:white; padding:10px 20px; text-decoration:none; display:inline-block; border-radius:4px; font-weight:bold;">📥 Xuất Báo Cáo Doanh Thu & Chi Phí (Excel)</a>
                </div>
                <table>
                    <thead>
                        <tr><th>Mã Báo Giá</th><th>Khách Hàng</th><th>Dự Án</th><th>Doanh Thu</th></tr>
                    </thead>
                    <tbody>
                        <% (quotes || []).forEach(q => { %>
                            <tr><td><%= q.quote_code %></td><td><%= q.customer_name %></td><td><%= q.project_name %></td><td><%= Number(q.total_amount || 0).toLocaleString('vi-VN') %> VNĐ</td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>

            <!-- TAB 8: CHI PHÍ -->
            <div id="tab-expenses" class="tab-content">
                <h3>Quản Lý Chi Phí Doanh Nghiệp</h3>
                <div class="form-box">
                    <h4>➕ Thêm Khoản Chi Phí</h4>
                    <input type="text" id="expType" placeholder="Loại chi phí">
                    <input type="text" id="expDesc" placeholder="Mô tả">
                    <input type="number" id="expAmount" placeholder="Số tiền (VNĐ)">
                    <input type="date" id="expDate">
                    <button onclick="addExpense()">Lưu Chi Phí</button>
                </div>
                <table>
                    <thead>
                        <tr><th>Loại Chi Phí</th><th>Mô Tả</th><th>Số Tiền</th><th>Ngày Nhập</th></tr>
                    </thead>
                    <tbody>
                        <% (expenses || []).forEach(e => { %>
                            <tr><td><%= e.expense_type %></td><td><%= e.description %></td><td><%= Number(e.amount || 0).toLocaleString('vi-VN') %> VNĐ</td><td><%= e.expense_date %></td></tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>

    </div>

    <!-- Modals -->
    <div id="loginModal" class="modal">
        <div class="modal-content">
            <h3>Đăng Nhập Quản Trị</h3>
            <input type="text" id="username" placeholder="Tài khoản"><br>
            <input type="password" id="password" placeholder="Mật khẩu"><br>
            <button onclick="submitLogin()">Đăng Nhập</button>
            <button onclick="closeLoginModal()" style="background: #aaa; margin-left: 10px;">Đóng</button>
        </div>
    </div>

    <div id="adminPanelModal" class="modal">
        <div class="modal-content">
            <h3>Đổi Mật Khẩu Admin</h3>
            <input type="password" id="oldPassword" placeholder="Mật khẩu cũ"><br>
            <input type="password" id="newPassword" placeholder="Mật khẩu mới"><br>
            <button onclick="changePassword()">Cập Nhật</button>
            <button onclick="closeAdminPanel()" style="background: #6c757d; margin-top:5px;">Đóng</button>
        </div>
    </div>

    <script>
        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.menu a').forEach(el => el.classList.remove('active-tab'));
            const targetTab = document.getElementById('tab-' + tabName);
            const targetMenu = document.getElementById('m-' + tabName);
            if (targetTab) targetTab.classList.add('active');
            if (targetMenu) targetMenu.classList.add('active-tab');
        }

        function openLoginModal() { document.getElementById('loginModal').style.display = 'flex'; }
        function closeLoginModal() { document.getElementById('loginModal').style.display = 'none'; }
        function openAdminPanel() { document.getElementById('adminPanelModal').style.display = 'flex'; }
        function closeAdminPanel() { document.getElementById('adminPanelModal').style.display = 'none'; }

        async function submitLogin() {
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value.trim();
            const res = await fetch('/api/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username, password }) });
            const data = await res.json();
            if (data.success) { alert('Đăng nhập thành công!'); window.location.reload(); }
            else { alert(data.message); }
        }

        async function logout() {
            await fetch('/api/logout', { method: 'POST' });
            window.location.reload();
        }

        async function addService() {
            const res = await fetch('/api/services/save', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ service_type: document.getElementById('sType').value, content: document.getElementById('sContent').value, warranty_maintenance: document.getElementById('sWarranty').value, price: document.getElementById('sPrice').value })
            });
            const data = await res.json();
            if (data.success) { alert('Thành công!'); window.location.reload(); } else { alert(data.message); }
        }

        async function addProject() {
            const res = await fetch('/api/projects/save', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ customer_name: document.getElementById('pCustName').value, project_name: document.getElementById('pProjName').value, completion_date: document.getElementById('pCompDate').value, warranty_months: document.getElementById('pWarrantyMos').value })
            });
            const data = await res.json();
            if (data.success) { alert('Thành công!'); window.location.reload(); } else { alert(data.message); }
        }

        async function addQuote() {
            const res = await fetch('/api/quotes/save', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ quote_code: document.getElementById('qCode').value, customer_name: document.getElementById('qCust').value, project_name: document.getElementById('qProj').value, address: document.getElementById('qAddress').value, total_amount: document.getElementById('qAmount').value })
            });
            const data = await res.json();
            if (data.success) { alert('Thành công!'); window.location.reload(); } else { alert(data.message); }
        }

        async function addWarehouseTicket() {
            const res = await fetch('/api/export-warehouse', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ customer_name: document.getElementById('wCust').value, project_name: document.getElementById('wProj').value, address: document.getElementById('wAddress').value, phone: document.getElementById('wPhone').value })
            });
            const data = await res.json();
            if (data.success) { alert('Tạo phiếu xuất kho thành công: ' + data.ticket_code); window.location.reload(); } else { alert(data.message); }
        }

        async function addExpense() {
            const res = await fetch('/api/expenses/save', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ expense_type: document.getElementById('expType').value, description: document.getElementById('expDesc').value, amount: document.getElementById('expAmount').value, expense_date: document.getElementById('expDate').value })
            });
            const data = await res.json();
            if (data.success) { alert('Thành công!'); window.location.reload(); } else { alert(data.message); }
        }
    </script>
</body>
</html>
