        // Quản lý Dự Án Khách Hàng (Thêm / Sửa / Xóa)
        function editProject(id, custName, projName, compDate, warrantyMos) {
            document.getElementById('projFormTitle').innerText = '✏️ Chỉnh Sửa Dự Án';
            document.getElementById('pId').value = id;
            document.getElementById('pCustName').value = custName;
            document.getElementById('pProjName').value = projName;
            document.getElementById('pCompDate').value = compDate;
            document.getElementById('pWarrantyMos').value = warrantyMos;
            document.getElementById('btnCancelProj').style.display = 'inline-block';
        }

        function resetProjectForm() {
            document.getElementById('projFormTitle').innerText = '➕ Thêm Dự Án Mới';
            document.getElementById('pId').value = '';
            document.getElementById('pCustName').value = '';
            document.getElementById('pProjName').value = '';
            document.getElementById('pCompDate').value = '';
            document.getElementById('pWarrantyMos').value = '';
            document.getElementById('btnCancelProj').style.display = 'none';
        }

        async function saveProject() {
            const id = document.getElementById('pId').value;
            const customer_name = document.getElementById('pCustName').value;
            const project_name = document.getElementById('pProjName').value;
            const completion_date = document.getElementById('pCompDate').value;
            const warranty_months = document.getElementById('pWarrantyMos').value;

            const res = await fetch('/api/projects/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id: id || null, customer_name, project_name, completion_date, warranty_months })
            });
            const data = await res.json();
            if (data.success) { alert('Lưu dự án thành công!'); window.location.reload(); }
            else { alert('Lỗi: ' + data.message); }
        }

        async function deleteProject(id) {
            if (!confirm('Bạn có chắc chắn muốn xóa dự án này?')) return;
            const res = await fetch('/api/projects/delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            const data = await res.json();
            if (data.success) { alert('Xóa dự án thành công!'); window.location.reload(); }
            else { alert('Lỗi: ' + data.message); }
        }

        async function submitLogin() {
            const username = document.getElementById('username').value.trim();
            const password = document.getElementById('password').value.trim();
            const res = await fetch('/api/login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ username, password }) });
            const data = await res.json();
            if (data.success) { alert('Đăng nhập thành công!'); window.location.reload(); }
            else { alert(data.message); }
        }

        async function logout() {
            await fetch('/api/logout', { method: 'POST' });
            window.location.reload();
        }

        let quoteItemsList = [];

        function addItemToQuote() {
            const select = document.getElementById('selectProduct');
            const opt = select.options[select.selectedIndex];
            if (!opt.value) return alert('Vui lòng chọn sản phẩm!');
            
            const productId = opt.value;
            const productName = opt.getAttribute('data-name');
            const price = parseFloat(opt.getAttribute('data-price')) || 0;
            const qty = parseInt(document.getElementById('itemQty').value) || 1;

            quoteItemsList.push({ productId, productName, qty, price });
            renderQuoteItemsTable();
        }

        function renderQuoteItemsTable() {
            const tbody = document.querySelector('#quoteItemsTable tbody');
            tbody.innerHTML = '';
            quoteItemsList.forEach((item, index) => {
                let total = item.qty * item.price;
                tbody.innerHTML += `
                    <tr>
                        <td>${item.productName}</td>
                        <td>${item.qty}</td>
                        <td>${item.price.toLocaleString('vi-VN')} đ</td>
                        <td>${total.toLocaleString('vi-VN')} đ</td>
                        <td><button type="button" onclick="removeQuoteItem(${index})" style="background:red; color:white; border:none; padding:3px 8px; cursor:pointer;">Xóa</button></td>
                    </tr>
                `;
            });
            calculateQuoteTotal();
        }

        function removeQuoteItem(index) {
            quoteItemsList.splice(index, 1);
            renderQuoteItemsTable();
        }

        function calculateQuoteTotal() {
            let itemsTotal = quoteItemsList.reduce((sum, item) => sum + (item.qty * item.price), 0);
            let survey = parseFloat(document.getElementById('surveyCost').value) || 0;
            let construction = parseFloat(document.getElementById('constructionCost').value) || 0;
            let grandTotal = itemsTotal + survey + construction;
            document.getElementById('quoteTotalDisplay').innerText = grandTotal.toLocaleString('vi-VN');
            return grandTotal;
        }

        function fillDataFromQuote() {
            const select = document.getElementById('selectQuoteCode');
            const opt = select.options[select.selectedIndex];
            if (opt.value) {
                document.getElementById('wCust').value = opt.getAttribute('data-cust');
                document.getElementById('wProj').value = opt.getAttribute('data-proj');
                document.getElementById('wAddress').value = opt.getAttribute('data-addr');
            }
        }

        async function saveAndPrintQuote() {
            const quote_code = document.getElementById('qCode').value;
            const customer_name = document.getElementById('qCust').value;
            const project_name = document.getElementById('qProj').value;
            const address = document.getElementById('qAddress').value;
            const total_amount = calculateQuoteTotal();

            if (!quote_code || !customer_name) {
                alert('Vui lòng nhập Mã báo giá và Tên khách hàng!');
                return;
            }

            const res = await fetch('/api/quotes/save', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ quote_code, customer_name, project_name, address, total_amount, items: quoteItemsList })
            });
            const data = await res.json();
            if (data.success) {
                alert('Lưu báo giá thành công! Đang chuẩn bị in A4...');
                window.print();
                window.location.reload();
            } else {
                alert('Lỗi: ' + data.message);
            }
        }

        async function createWarehouseTicket() {
            const customer_name = document.getElementById('wCust').value;
            const project_name = document.getElementById('wProj').value;
            const address = document.getElementById('wAddress').value;
            const phone = document.getElementById('wPhone').value;

            const res = await fetch('/api/export-warehouse', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ customer_name, project_name, address, phone })
            });
            const data = await res.json();
            if (data.success) {
                alert('Xuất kho thành công, đã giảm trừ tồn kho! Mã phiếu: ' + data.ticket_code);
                window.print();
                window.location.reload();
            } else {
                alert('Lỗi: ' + data.message);
            }
        }

        async function addService() {
            const res = await fetch('/api/services/save', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ service_type: document.getElementById('sType').value, content: document.getElementById('sContent').value, warranty_maintenance: document.getElementById('sWarranty').value, price: document.getElementById('sPrice').value })
            });
            const data = await res.json();
            if (data.success) { alert('Thành công!'); window.location.reload(); } else { alert(data.message); }
        }

        async function addExpense() {
            const res = await fetch('/api/expenses/save', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ expense_type: document.getElementById('expType').value, description: document.getElementById('expDesc').value, amount: document.getElementById('expAmount').value, expense_date: document.getElementById('expDate').value })
            });
            const data = await res.json();
            if (data.success) { alert('Thành công!'); window.location.reload(); } else { alert(data.message); }
        }
    </script>
